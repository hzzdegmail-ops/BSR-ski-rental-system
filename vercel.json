{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node build-vercel.mjs",
  "outputDirectory": "public",
  "regions": ["hkg1"],
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "{dist/**,server/**,local.mjs,build.mjs,.openai/hosting.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__bsr_route=:path*" }
  ]
}
